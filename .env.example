# Backend development placeholders; replace locally and never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/phoenix-bos.sqlite
JWT_SECRET=replace-with-at-least-32-random-bytes
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=Phoenix Administrator

# Telegram worker placeholders.
TELEGRAM_BOT_TOKEN=000000000:replace-with-a-real-token-locally
TELEGRAM_ALLOWED_USER_IDS=123456789
PHOENIX_API_URL=http://127.0.0.1:3000
PHOENIX_BOT_EMAIL=bot@example.com
PHOENIX_BOT_PASSWORD=replace-with-a-strong-password
TELEGRAM_DRY_RUN=false
